<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only, independent of each machine's user-level NuGet sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
