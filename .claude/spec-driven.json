{
  "specsDir": "_specs",
  "protectedBranches": ["main"],
  "allowOnProtected": ["_specs/", ".claude/", "CLAUDE.md"],
  "verify": {
    "shell": null,
    "failPattern": null,
    "format": null,
    "commands": [
      "dotnet build Zyggy.slnx -v q -nologo",
      "dotnet test Zyggy.slnx --no-build --filter \"Category!=Integration\"",
      "dotnet test tests/Zyggy.Integration/Zyggy.Integration.csproj --no-build",
      "dotnet format Zyggy.slnx --verify-no-changes"
    ],
    "integration": {
      "command": "dotnet test tests/Zyggy.Integration/Zyggy.Integration.csproj --no-build",
      "filter": "--filter \"{tests}\"",
      "test": "FullyQualifiedName~{name}",
      "separator": "|"
    }
  }
}
