{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(_plans/**)",
      "Edit(_specs/**)",
      "Edit(*/**)",
      "Glob",
      "Grep",
      "TodoWrite",
      "Task",
      "WebFetch",
      "WebSearch",
      "Skill(*)",
      "Bash(dotnet build *)",
      "Bash(dotnet format *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet pack *)",
      "Bash(dotnet tool *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet format *)",
      "PowerShell(dotnet restore *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :refs/tags/*)",
      "Bash(git tag -d *)",
      "Bash(git tag -f *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * HEAD:main)",
      "PowerShell(git push --delete *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * :refs/tags/*)",
      "PowerShell(git tag -d *)",
      "PowerShell(git tag -f *)"
    ],
    "defaultMode": "acceptEdits"
  }
}

