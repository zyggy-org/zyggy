<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Zyggy.Core/Zyggy.Core.csproj" />
    <ProjectReference Include="../../src/Zyggy.Node/Zyggy.Node.csproj" />
    <ProjectReference Include="../../src/Zyggy.Cli/Zyggy.Cli.csproj" />
    <ProjectReference Include="../../tools/fake-claude/FakeClaude.csproj" />
  </ItemGroup>

  <!-- Golden envelopes (deliverable 03) and the single file that holds the synthetic test keys, shared with Zyggy.Core.Tests. -->
  <ItemGroup>
    <None Include="../golden/**" CopyToOutputDirectory="PreserveNewest" LinkBase="golden" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/TestKeys.cs" Link="Infrastructure/TestKeys.cs" />
    <!-- Deliverable 33: the stubbed login host and Graph, and the per-test key pairs. -->
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/Golden.cs" Link="Infrastructure/Golden.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/StubGraphHandler.cs" Link="Infrastructure/StubGraphHandler.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/StubOneDrive.cs" Link="Infrastructure/StubOneDrive.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/TestCertificates.cs" Link="Infrastructure/TestCertificates.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/VerbConsole.cs" Link="Infrastructure/VerbConsole.cs" />
    <!-- Deliverable 04: the secret sweep (AC-29) and the signed test envelopes shared with the unit tests. -->
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/SecretSweep.cs" Link="Infrastructure/SecretSweep.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/ThrowingSecretStore.cs" Link="Infrastructure/ThrowingSecretStore.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/FakeHiddenInput.cs" Link="Infrastructure/FakeHiddenInput.cs" />
    <Compile Include="../Zyggy.Core.Tests/Infrastructure/TestEnvelopes.cs" Link="Infrastructure/TestEnvelopes.cs" />
  </ItemGroup>

  <!--
    Deliverable 07: Zyggy.Node carries the Microsoft.AspNetCore.App framework reference, which flows into this test host. The SDK then
    drops from this output every package assembly the shared framework also provides (Microsoft.Extensions.DependencyInjection*,
    Options, …). The in-process tests are fine, but `zyggy` — a plain console app launched out of process from this directory — cannot
    find them (CI on Linux: FileNotFoundException for Microsoft.Extensions.DependencyInjection.Abstractions). The CLI therefore runs
    from its own build output, copied verbatim into <OutDir>cli/ (see ZyggyCli.ExecutablePath); zyggy-node and fake-claude are unaffected.
  -->
  <Target Name="CopyCliOutputForOutOfProcessTests" AfterTargets="Build">
    <MSBuild Projects="../../src/Zyggy.Cli/Zyggy.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_ZyggyCliTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ZyggyCliOutputDir>$([System.IO.Path]::GetDirectoryName('$(_ZyggyCliTargetPath)'))</_ZyggyCliOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_ZyggyCliFiles Include="$(_ZyggyCliOutputDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZyggyCliFiles)" DestinationFiles="@(_ZyggyCliFiles->'$(OutDir)cli/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
