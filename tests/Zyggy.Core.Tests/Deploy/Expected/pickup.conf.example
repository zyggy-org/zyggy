# Required on Central from deliverable 13: the memory principal and secret patterns the node's pickup needs (founding spec §7 step 1, §10).
# Copy to /etc/systemd/system/zyggy-node.service.d/pickup.conf, replace <instance-dir> and <zyggy-home>, then: systemctl daemon-reload && systemctl restart zyggy-node.
# Without it the node on Central exits 3 (configuration error: pickup: …); laptops ignore these variables.
[Service]
Environment=ZYGGY_MEMORY_ROOT=<instance-dir>/memory
Environment=ZYGGY_TENANT=acme
Environment=ZYGGY_USER=alice
Environment=ZYGGY_TIMEZONE=UTC
Environment=ZYGGY_SECRET_PATTERNS=<instance-dir>/.claude/hooks/secret-patterns.txt
# Archive items from the laptops (deliverable 41): the instance directory holds archive.json and m365.json; the Graph application key
# lets the pickup download OneDrive-route items read-only. Without these two, archive items wait on the bus (deliverable 41): every item
# without ZYGGY_INSTANCE_DIR, OneDrive-route items without the key. Neither stops the node.
Environment=ZYGGY_INSTANCE_DIR=<instance-dir>/instance
LoadCredential=m365-app-key:<zyggy-home>/.config/zyggy/m365-app.key
