<Project Sdk="Microsoft.NET.Sdk">

  <!-- LibraryImport (source-generated P/Invoke) for lstat/geteuid: the credential store's owner check (plan 33 Assumption 5). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ulid" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <!-- Deliverable 07: IANA ids for workHours.timezone under InvariantGlobalization (spec 07 ex-Q2). -->
    <PackageReference Include="TimeZoneConverter" />
  </ItemGroup>

  <!-- The dream model contract (OQ-3): prompts and schemas ship inside the binary. -->
  <ItemGroup>
    <EmbeddedResource Include="Dream/Prompts/*" LogicalName="Zyggy.Core.Dream.Prompts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Brief/Prompts/*" LogicalName="Zyggy.Core.Brief.Prompts.%(Filename)%(Extension)" />
    <!-- The job prompt (spec 06 ex-Q6): embedded, so nothing in a project or on the bus can alter it (§8). -->
    <EmbeddedResource Include="Jobs/Prompts/*" LogicalName="Zyggy.Core.Jobs.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zyggy.Core.Tests" />
    <InternalsVisibleTo Include="Zyggy.Integration" />
    <!-- Deliverable 08 (plan A9, owner-approved): the Node serialises the shared /health body with Core's internal JSON context, byte-identical to 07. -->
    <InternalsVisibleTo Include="zyggy-node" />
    <!-- NSubstitute proxies for internal types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
