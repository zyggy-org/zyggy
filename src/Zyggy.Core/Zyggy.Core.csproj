<Project Sdk="Microsoft.NET.Sdk">

  <!-- LibraryImport (source-generated P/Invoke) for lstat/geteuid: the credential store's owner check (plan 33 Assumption 5). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ulid" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The dream model contract (OQ-3): prompts and schemas ship inside the binary. -->
  <ItemGroup>
    <EmbeddedResource Include="Dream/Prompts/*" LogicalName="Zyggy.Core.Dream.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zyggy.Core.Tests" />
    <InternalsVisibleTo Include="Zyggy.Integration" />
    <!-- NSubstitute proxies for internal types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
